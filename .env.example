# PostSpritz Environment Configuration

# App
NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
INTERNAL_API_URL=http://localhost:4000

# Database (PostgreSQL)
DATABASE_URL=postgresql://postspritz:password@localhost:5432/postspritz
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20

# Redis
REDIS_URL=redis://localhost:6379

# Session & JWT
SESSION_SECRET=c29tZV9yYW5kb21fc3VwZXJfc2VjcmV0X3Nlc3Npb25fa2V5XzEyMzQ1Njc4OTA=
SESSION_MAX_AGE=86400000
JWT_SECRET=YW5vdGhlcl9zdXBlcl9zZWNyZXRfand0X2tleV9mb3JfcHVzaHBvc3RfYXBpXzEyMw==
JWT_EXPIRES_IN=15m

# OAuth Token Encryption at Rest (32 bytes / 64 hex chars)
TOKEN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Cloudflare R2 Storage (S3-compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=postspritz-media
R2_PUBLIC_URL=

# Fallback S3 / Local MinIO
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=postspritz-media
S3_REGION=auto

# Firebase Admin Console (FCM Push Notifications)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Brevo (Sendinblue) Email
BREVO_API_KEY=xkeysib-mock-local
BREVO_SENDER_EMAIL=noreply@postspritz.com
BREVO_SENDER_NAME=PostSpritz

# AI Service
AI_SERVICE_URL=http://localhost:8000
AI_DEFAULT_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=

# Payments (Deferred for free launch)
BILLING_GATEWAY_DEFAULT=cashfree
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Social OAuth Credentials
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=/api/social-accounts/oauth/linkedin/callback

FACEBOOK_APP_ID=
